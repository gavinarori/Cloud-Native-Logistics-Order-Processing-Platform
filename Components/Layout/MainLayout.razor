@inherits LayoutComponentBase

<div class="app-shell d-flex">
    <!-- Sidebar -->
    <NavMenu />

    <!-- Main content area -->
    <div class="main-content flex-grow-1 d-flex flex-column">

        <!-- Top bar -->
        <header class="topbar d-flex align-items-center px-4 py-2 border-bottom bg-white shadow-sm">
            <button class="btn btn-link text-secondary d-lg-none me-2" id="sidebar-toggle">
                <i class="bi bi-list fs-4"></i>
            </button>
            <div class="ms-auto d-flex align-items-center gap-3">
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                    <i class="bi bi-circle-fill me-1" style="font-size:0.5rem"></i>Azure Services Healthy
                </span>
                <div class="dropdown">
                    <button class="btn btn-link text-secondary p-0" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle fs-4"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Profile</a></li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Page content -->
        <main class="page-body flex-grow-1 p-4 bg-light">
            @Body
        </main>

        <footer class="text-center text-muted py-2 border-top bg-white" style="font-size:0.75rem">
            LogiOps &copy; @DateTime.Now.Year — Cloud-Native on Azure &nbsp;|&nbsp;
            <span class="text-success"><i class="bi bi-shield-check me-1"></i>Zero Trust Enabled</span>
        </footer>
    </div>
</div>

<div id="blazor-error-ui" class="alert alert-danger m-3 d-none" role="alert">
    An unhandled error has occurred.
    <a href="" class="alert-link">Reload</a>
    <button type="button" class="btn-close" aria-label="Close"
            onclick="document.getElementById('blazor-error-ui').classList.add('d-none')"></button>
</div>
