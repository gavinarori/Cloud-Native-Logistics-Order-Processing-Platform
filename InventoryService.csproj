<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InventoryService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure Identity & Key Vault -->
    <PackageReference Include="Azure.Identity"                       Version="1.12.0" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />

    <!-- Cosmos DB — read model (NoSQL API) -->
    <PackageReference Include="Microsoft.Azure.Cosmos"               Version="3.41.0" />

    <!-- Redis — cache-aside layer in front of Cosmos DB -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.0" />

    <!-- OpenAPI -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"         Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore"               Version="6.7.3" />

    <!-- Telemetry -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />

    <!-- Health checks -->
    <PackageReference Include="AspNetCore.HealthChecks.CosmosDb"     Version="8.0.1" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis"         Version="8.0.1" />
  </ItemGroup>

</Project>