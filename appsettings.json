{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",


  "Azure": {
    "KeyVaultUri": "https://kv-logistics-prod.vault.azure.net/",
    "ServiceBus": {
      "FullyQualifiedNamespace": "sb-logistics-prod.servicebus.windows.net",
      "OrderQueueName": "orders-fifo-queue",
      "DeadLetterQueueName": "orders-fifo-queue/$DeadLetterQueue"
    }
  },


  "ConnectionStrings": {
