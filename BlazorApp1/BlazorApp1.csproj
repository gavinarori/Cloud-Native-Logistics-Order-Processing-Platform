<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Changed net8.0 → net10.0 to match the .NET version installed on this machine.
      Your Mac has .NET 10.0.9 — targeting net8.0 caused the "framework not found" error.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LogisticsWeb</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure Identity + Key Vault -->
    <PackageReference Include="Azure.Identity"                                     Version="1.13.2" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />

    <!-- Azure Service Bus -->
    <PackageReference Include="Azure.Messaging.ServiceBus"                        Version="7.18.4" />

    <!-- Redis cache -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis"   Version="9.0.0" />

    <!-- Application Insights -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore"          Version="2.22.0" />
  </ItemGroup>

</Project>
