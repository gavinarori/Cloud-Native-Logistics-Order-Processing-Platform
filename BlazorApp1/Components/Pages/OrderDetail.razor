@page "/orders/{Id:guid}"
@attribute [StreamRendering]
@rendermode InteractiveServer
@inject IOrderService OrderService

<PageTitle>Order Detail | LogiOps</PageTitle>

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/orders" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Orders
    </a>
    <h1 class="h3 mb-0 fw-semibold">Order Detail</h1>
</div>

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary mb-2"></div>
        <div class="text-muted">Loading from Azure SQL…</div>
    </div>
}
else if (_order is null)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-search fs-1 d-block mb-2"></i>
            Order <code>@Id</code> not found.
            <div class="mt-3">
                <small>
                    If you just created this order, the Worker Function may still be processing the
                    Service Bus message. Check back in a few seconds.
                </small>
            </div>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Left: order info -->
        <div class="col-lg-8">
            <!-- Header card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
                        <div>
                            <div class="text-muted" style="font-size:0.8rem">Order ID</div>
                            <code class="fs-6">@_order.Id</code>
                        </div>
                        <StatusBadge Status="_order.Status" />
                    </div>
                    <hr />
                    <div class="row g-3">
                        <div class="col-sm-4">
                            <div class="text-muted" style="font-size:0.8rem">Customer</div>
                            <div class="fw-semibold">@_order.CustomerName</div>
                            <div class="text-muted">@_order.CustomerEmail</div>
                        </div>
                        <div class="col-sm-4">
                            <div class="text-muted" style="font-size:0.8rem">Region</div>
                            <span class="badge bg-secondary-subtle text-secondary border">@_order.Region</span>
                        </div>
                        <div class="col-sm-4">
                            <div class="text-muted" style="font-size:0.8rem">Created (UTC)</div>
                            <div>@_order.CreatedAt.ToString("dd MMM yyyy HH:mm:ss")</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items table -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom fw-semibold">
                    <i class="bi bi-bag me-2 text-primary"></i>Order Items (@_order.TotalItems items)
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>SKU</th>
                                <th>Product</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _order.Items)
                            {
                                <tr>
                                    <td class="font-monospace text-muted">@item.Sku</td>
                                    <td>@item.ProductName</td>
                                    <td class="text-end">@item.Quantity</td>
                                    <td class="text-end">@item.UnitPrice.ToString("C2")</td>
                                    <td class="text-end fw-semibold">
                                        @((item.Quantity * item.UnitPrice).ToString("C2"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Order Total</td>
                                <td class="text-end fw-bold fs-5">
                                    @_order.TotalAmount.ToString("C2")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right: status timeline -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom fw-semibold">
                    <i class="bi bi-diagram-2 me-2 text-primary"></i>Processing Pipeline
                </div>
                <div class="card-body">
                    <PipelineStep
                        Icon="bi-send-fill"
                        Label="Enqueued to Service Bus"
                        Completed="true"
                        Description="FIFO queue — duplicate detection enabled" />

                    <PipelineStep
                        Icon="bi-lightning-fill"
                        Label="Worker Function Processing"
                        Completed="@(_order.Status is OrderStatus.Processing or OrderStatus.Fulfilled)"
                        Active="@(_order.Status == OrderStatus.Queued)"
                        Description="Flex Consumption — scaled from queue depth" />

                    <PipelineStep
                        Icon="bi-database-fill"
                        Label="Written to Azure SQL"
                        Completed="@(_order.Status is OrderStatus.Fulfilled)"
                        Active="@(_order.Status == OrderStatus.Processing)"
                        Description="Business Critical — ACID compliant write" />

                    <PipelineStep
                        Icon="bi-arrow-repeat"
                        Label="Synced to Cosmos DB"
                        Completed="@(_order.Status == OrderStatus.Fulfilled)"
                        Description="CDC via Azure Data Factory — eventual consistency" />

                    <PipelineStep
                        Icon="bi-check-circle-fill"
                        Label="Fulfilled"
                        Completed="@(_order.Status == OrderStatus.Fulfilled)"
                        IsLast="true"
                        Description="Order visible in read model (Redis cached)" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Order? _order;
    private bool   _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _order   = await OrderService.GetOrderByIdAsync(Id);
        _loading = false;
    }
}
