@page "/inventory"
@attribute [StreamRendering]
@rendermode InteractiveServer
@inject IInventoryService InventoryService

<PageTitle>Inventory | LogiOps</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 fw-semibold">Inventory</h1>
        <small class="text-muted">
            Read model —
            <span class="badge bg-info-subtle text-info border border-info-subtle">Azure Cache for Redis</span>
            →
            <span class="badge bg-secondary-subtle text-secondary border">Cosmos DB (CDC synced)</span>
        </small>
    </div>
    <div class="text-muted" style="font-size:0.8rem">
        @if (_summary is not null)
        {
            <span>Last synced: @_summary.ComputedAt.ToString("HH:mm:ss") UTC</span>
        }
    </div>
</div>

<!-- Summary KPIs -->
@if (_summary is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <KpiCard Icon="bi-box-seam"       Title="Total SKUs"     Value="@_summary.TotalProducts.ToString()"  Color="primary" />
        </div>
        <div class="col-6 col-md-3">
            <KpiCard Icon="bi-stack"          Title="Total Units"    Value="@_summary.TotalUnits.ToString("N0")" Color="info" />
        </div>
        <div class="col-6 col-md-3">
            <KpiCard Icon="bi-exclamation-triangle" Title="Low Stock" Value="@_summary.LowStockCount.ToString()" Color="warning" />
        </div>
        <div class="col-6 col-md-3">
            <KpiCard Icon="bi-x-circle"       Title="Out of Stock"   Value="@_summary.OutOfStockCount.ToString()" Color="danger" />
        </div>
    </div>
}

<!-- Filters -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2 d-flex gap-3 flex-wrap align-items-center">
        <div class="d-flex align-items-center gap-2">
            <label class="text-muted" style="font-size:0.85rem">Category</label>
            <select class="form-select form-select-sm" style="width:auto"
                    @bind="_categoryFilter" @bind:after="FilterItems">
                <option value="">All categories</option>
                @foreach (var cat in _categories)
                {
                    <option>@cat</option>
                }
            </select>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="text-muted" style="font-size:0.85rem">Stock status</label>
            <select class="form-select form-select-sm" style="width:auto"
                    @bind="_stockFilter" @bind:after="FilterItems">
                <option value="">All</option>
                <option value="InStock">In Stock</option>
                <option value="LowStock">Low Stock</option>
                <option value="OutOfStock">Out of Stock</option>
            </select>
        </div>
        <div class="ms-auto">
            <input class="form-control form-control-sm" style="width:220px"
                   placeholder="Search SKU or name…"
                   @oninput="OnSearch" />
        </div>
    </div>
</div>

<!-- Inventory table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (_loading)
        {
            <div class="p-5 text-center text-muted">
                <div class="spinner-border text-primary mb-2"></div>
                <div>Reading from Redis cache…</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>SKU</th>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Warehouse</th>
                            <th class="text-end">Stock</th>
                            <th class="text-end">Reorder At</th>
                            <th>Status</th>
                            <th style="font-size:0.78rem" class="text-muted">CDC Sync</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _filtered)
                        {
                            <tr class="@(item.Status == StockStatus.OutOfStock ? "table-danger" : item.Status == StockStatus.LowStock ? "table-warning" : "")">
                                <td class="font-monospace">@item.Sku</td>
                                <td class="fw-semibold">@item.ProductName</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border">@item.Category</span>
                                </td>
                                <td class="text-muted">@item.WarehouseLocation</td>
                                <td class="text-end fw-semibold">@item.StockLevel.ToString("N0")</td>
                                <td class="text-end text-muted">@item.ReorderPoint.ToString("N0")</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case StockStatus.InStock:
                                            <span class="badge bg-success"><i class="bi bi-check me-1"></i>In Stock</span>
                                            break;
                                        case StockStatus.LowStock:
                                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation me-1"></i>Low Stock</span>
                                            break;
                                        case StockStatus.OutOfStock:
                                            <span class="badge bg-danger"><i class="bi bi-x me-1"></i>Out of Stock</span>
                                            break;
                                    }
                                </td>
                                <td class="text-muted" style="font-size:0.78rem">
                                    @item.LastSyncedAt.ToString("HH:mm:ss")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="px-3 py-2 text-muted border-top" style="font-size:0.8rem">
                Showing @_filtered.Count of @_allItems.Count SKUs
                — eventual consistency note: stock levels may lag Azure SQL by a few seconds (CDC sync)
            </div>
        }
    </div>
</div>

@code {
    private List<InventoryItem> _allItems       = [];
    private List<InventoryItem> _filtered       = [];
    private List<string>        _categories     = [];
    private InventorySummary?   _summary;
    private bool   _loading        = true;
    private string _categoryFilter = "";
    private string _stockFilter    = "";
    private string _searchTerm     = "";

    protected override async Task OnInitializedAsync()
    {
        var itemsTask      = InventoryService.GetInventoryAsync();
        var categoriesTask = InventoryService.GetCategoriesAsync();
        var summaryTask    = InventoryService.GetSummaryAsync();

        await Task.WhenAll(itemsTask, categoriesTask, summaryTask);

        _allItems   = await itemsTask;
        _categories = await categoriesTask;
        _summary    = await summaryTask;
        _loading    = false;

        FilterItems();
    }

    private void FilterItems()
    {
        _filtered = _allItems
            .Where(i => string.IsNullOrEmpty(_categoryFilter) || i.Category == _categoryFilter)
            .Where(i => string.IsNullOrEmpty(_stockFilter)    || i.Status.ToString() == _stockFilter)
            .Where(i => string.IsNullOrEmpty(_searchTerm)
                        || i.Sku.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                        || i.ProductName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? "";
        FilterItems();
    }
}
